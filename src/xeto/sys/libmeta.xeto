// Library module meta data - see [doc.xeto::Libs#pragma].
Lib: Dict <sealed> {

//////////////////////////////////////////////////////////////////////////
// Reserved
//////////////////////////////////////////////////////////////////////////

  // Identifier of the lib formatted as "lib:name"
  id: Ref <sealed>

  // Dotted name of the library
  name: Str <sealed>

  // Spec reference - always `sys::Lib`
  spec: Ref <of:Spec, sealed>

  // Top-level type and mixin specs
  specs: Dict <of:Spec, sealed>

  // Top-level type specs
  types: Dict <of:Spec, sealed>

  // Top-level mixin specs
  mixins: Dict <of:Spec, sealed>

  // Top-level instances
  instances: Dict <of:Dict, sealed>

  // File location of the lib pragma definition
  loc: Obj <sealed, nodoc>

//////////////////////////////////////////////////////////////////////////
// Non-Reserved
//////////////////////////////////////////////////////////////////////////

  // Free form category tags
  categories: List? <of:Str>

  // Short summary formatted as [xetodoc](doc.xeto::Xetodoc)
  doc: Str?

  // Library dependencies
  depends: List <of:LibDepend>

  // Patterns selecting the files to package into the lib which are
  // not published; see [packaging](doc.xeto::Build#packaging)
  include: List? <of:LibFilePattern>

  // License [SPDX name](https://spdx.org/licenses/) or "commerical"
  license: Str?

  // Publication maturity declared by the library author.
  // Defaults to `stable` if omitted.
  maturity: LibMaturity?

  // Marks library as undocumented
  nodoc: Marker?

  // Library organization information
  org: LibOrg?

  // Patterns selecting the files to package into the lib and publish
  // with their own uri; see [packaging](doc.xeto::Build#packaging)
  publish: List? <of:LibFilePattern>

  // Library version control system metadata
  vcs: LibVcs?

  // Version number
  version: Version
}

//////////////////////////////////////////////////////////////////////////
// Helper Types
//////////////////////////////////////////////////////////////////////////

// Library dependency
LibDepend: Dict <sealed> {
  lib: Str                      // Library qualified dotted name
  versions: LibDependVersions   // Version constraints for dependency
}

// Version constraints for a library dependency.
//
// The format is:
// ```
// <versions>  :=  <wildcard> | <range>
// <wildcard>  :=  <seg> "." <seg> "." <seg>
// <range>     :=  <wildcard> "-" <wildcard>
// <seg>       :=  <digits> | "x"
// ```
//
// Examples:
// ```
// 1.5.20           // match only 1.5.20
// 1.5.x            // match any patch version within 1.5
// 3.x.x            // match any version with 3 as major version
// 1.5.20 - 1.x.x   // greater than 1.5.20 and has 1 in major ver
// ```
LibDependVersions: Scalar <sealed>

// Path used to select files from a lib's source directory for
// [packaging](doc.xeto::Build#packaging).  A pattern takes one of
// three forms:
//
// ```
// /doc            // directory: every file in the subtree
// /doc/index.md   // file: exactly one file
// /*.svg          // extension: the svg files at the lib root
// /doc/*.svg      // extension: the svg files directly in "/doc"
// ```
//
// A pattern is written the same way a lib file is addressed, rooted at
// the lib with a leading slash.  The "*" wildcard may appear only as the
// whole final section in the form "*.ext".  Patterns have no trailing
// slash, no "..", and no backslashes.
LibFilePattern: Scalar <sealed>

// Organization library metadata - see [doc.xeto::Libs#org].
LibOrg: Dict {
  dis: Str     // Display name for the organization
  uri: Uri     // URI for organization website
}

// Version control library metadata
LibVcs: Dict {
  type: Str    // Type of VCS such as "git" or "mercurial"
  uri: Uri     // URI for repository to be used directly by a VCS program (not the HTML page)
}

// Publication maturity of a library version as claimed by its author.
// A repo seeds its catalog maturity from this claim at publish.
// Maturity is orthogonal to a repo's availability lifecycle - see
// [sys.repo::RepoLibAvailability].
LibMaturity: Enum {
  alpha     // Early experimental prerelease
  beta      // Feature complete prerelease
  stable    // Stable production release
}

