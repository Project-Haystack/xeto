// Rules for constraints the ontology cannot express as slots: agreement
// between a rec and the recs it references.  The slot declarations handle
// which tags may be present and what they point to; these handle whether
// the values agree once they are.

//////////////////////////////////////////////////////////////////////////
// Point
//////////////////////////////////////////////////////////////////////////

// Point must be associated with a site or a weather station
@pointMissingSiteRef: ValidateRule {
  on: Point
  msg: "Point must have siteRef or weatherStationRef"
}

// Point should declare the timezone of its histories
@pointMissingTz: ValidateRule {
  on: Point
  level: "warn"
  msg: "Point should have tz"
}

// Point timezone must match the site it belongs to
@pointSiteTz: ValidateRule {
  on: Point
  msg: "Point tz '$val' does not match site tz '$siteTz'"
}

// Point value constraints must use the point's own unit
@pointValUnit: ValidateRule {
  on: NumberPoint
  msg: "$slot $val must have unit of '$unit'"
}

// Point minimum must not exceed its maximum
@pointMinMax: ValidateRule {
  on: NumberPoint
  msg: "minVal $val is above maxVal $maxVal"
}

//////////////////////////////////////////////////////////////////////////
// Containment
//////////////////////////////////////////////////////////////////////////

// Everything the containment refs lead to must be in the same site.  The
// equipRef, spaceRef, and systemRef tags form a tree rooted at a site, so
// every ancestor of a rec must agree with its siteRef.
@refSite: ValidateRule {
  on: PhEntity
  unless: @refCycle
  msg: "$refTag leads to site @$refSite, not siteRef @$val"
}

// The containment refs must form a tree, not a cycle.  A cycle makes the
// parent and child queries which walk them recurse forever.
@refCycle: ValidateRule {
  on: PhEntity
  msg: "$refTag forms a cycle: $path"
}
