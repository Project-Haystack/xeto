//////////////////////////////////////////////////////////////////////////
// Elec
//////////////////////////////////////////////////////////////////////////

// Sensor for electricity
ElecSensor : NumberPoint & SensorPoint <abstract> { elec }

// Command for electricity
ElecCmd : NumberPoint & CmdPoint <abstract> { elec }

// Setpoint for electricity
ElecSp : NumberPoint & SpPoint <abstract> { elec }

// Max setpoint for electricity
ElecMaxSp : ElecSp <abstract> { max }

//////////////////////////////////////////////////////////////////////////
// Current
//////////////////////////////////////////////////////////////////////////

// Sensor for electric current
ElecCurrentSensor : ElecSensor <abstract> { current }

// Sensor for AC electric current
ElecAcCurrentSensor : ElecCurrentSensor <abstract> {
  ac
  elecSpectralScope: ElecSpectralScope?
  elecHarmonicOrder: Int? <minVal: 2>
  elecLocation: ElecLocation
}

// Sensor for magnitude of AC electric current
ElecAcMagnitudeCurrentSensor : ElecAcCurrentSensor <abstract> {
  magnitude
  unit: Unit <quantity:"electricCurrent"> "A"
  elecMagnitudeCalc: ElecMagnitudeCalc?
}

// Sensor for RMS of AC electric current.
ElecAcRmsCurrentSensor : ElecAcMagnitudeCurrentSensor {
  rootMeanSquare
  minVal: Number 0.0
}

// Sensor for instantaneous values of an AC electric current waveform
ElecAcWaveformCurrentSensor : ElecAcCurrentSensor {
  waveform
  unit: Unit <quantity:"electricCurrent"> "A"
}

// Sensor for angle of AC electric current
ElecAcAngleCurrentSensor : ElecAcCurrentSensor {
  angle
  unit: "deg"
}

// Sensor for metric of AC electric current
ElecAcQualityCurrentSensor : ElecAcCurrentSensor {
  elecQualityMetric: ElecQualityMetric
  unit: Unit <invariant> "%"
}

// Sensor for DC electric current
ElecDcCurrentSensor : ElecCurrentSensor {
  dc
  unit: Unit <quantity:"electricCurrent"> "A"
}

// Max setpoint for electric current
ElecCurrentMaxSp : ElecMaxSp <abstract> {
  current
  unit: Unit <quantity:"electricCurrent"> "A"
}

// Max setpoint for RMS of AC electric current
ElecAcCurrentMaxSp : ElecCurrentMaxSp {
  ac
  magnitude
  rootMeanSquare
  elecLocation: ElecLocation
}

// Max setpoint for DC electric current
ElecDcCurrentMaxSp : ElecCurrentMaxSp { dc }

//////////////////////////////////////////////////////////////////////////
// Current Demand
//////////////////////////////////////////////////////////////////////////

// Sensor for AC electric current demand
ElecAcCurrentDemandSensor : ElecAcDemandSensor {
  current
  unit: "A"
  minVal: Number 0.0
}

//////////////////////////////////////////////////////////////////////////
// Power Demand
//////////////////////////////////////////////////////////////////////////

// Sensor for AC electric power demand
ElecAcPowerDemandSensor : ElecAcDemandSensor <abstract> {
  power
  elecPowerQuantity: ElecPowerQuantity
  elecDirection: ElecDirection
}

// Sensor for AC electric active power demand
ElecAcActiveDemandSensor : ElecAcPowerDemandSensor {
  active
  unit: Unit <quantity:"power"> "kW"
}

// Sensor for AC electric reactive power demand
ElecAcReactiveDemandSensor : ElecAcPowerDemandSensor {
  reactive
  unit: Unit <quantity:"reactivePower"> "kVAR"
}

// Sensor for AC electric apparent power demand
ElecAcApparentDemandSensor : ElecAcPowerDemandSensor {
  apparent
  unit: Unit <quantity:"apparentPower"> "kVA"
}

// Max setpoint for electric power demand
ElecDemandMaxSp : ElecMaxSp <abstract> {
  demand
  unit: Unit <quantity:"power"> "kW"
}

// Max setpoint for AC electric active power demand
ElecAcActiveDemandMaxSp : ElecDemandMaxSp {
  ac
  active
  elecLocation: ElecLocation
}

//////////////////////////////////////////////////////////////////////////
// Demand
//////////////////////////////////////////////////////////////////////////

// Sensor for electric demand
ElecDemandSensor : ElecSensor <abstract> { demand }

// Sensor for AC electric demand
ElecAcDemandSensor : ElecDemandSensor <abstract> {
  ac
  elecLocation: ElecLocation
}

//////////////////////////////////////////////////////////////////////////
// Energy
//////////////////////////////////////////////////////////////////////////

// Sensor for electric energy
ElecEnergySensor : ElecSensor <abstract> {
  energy
  elecDirection: ElecDirection
}

// Sensor for AC electric energy
ElecAcEnergySensor : ElecEnergySensor <abstract> {
  ac
  elecPowerQuantity: ElecPowerQuantity
  elecLocation: ElecLocation
}

// Sensor for AC electric active energy
ElecAcActiveEnergySensor : ElecAcEnergySensor {
  active
  unit: Unit <quantity:"energy"> "kWh"
}

// Sensor for AC electric reactive energy
ElecAcReactiveEnergySensor : ElecAcEnergySensor {
  reactive
  unit: Unit <quantity:"reactiveEnergy"> "kVARh"
}

// Sensor for AC electric apparent energy
ElecAcApparentEnergySensor : ElecAcEnergySensor {
  apparent
  unit: Unit <quantity:"apparentEnergy"> "kVAh"
}

// Sensor for DC electric energy
ElecDcEnergySensor : ElecEnergySensor {
  dc
  unit: Unit <quantity:"energy"> "kWh"
}

//////////////////////////////////////////////////////////////////////////
// Frequency
//////////////////////////////////////////////////////////////////////////

// Sensor for AC electric frequency
ElecAcFreqSensor : ElecSensor {
  freq
  unit: "Hz"
  ac
}

// Command for AC electric frequency
ElecAcFreqCmd : ElecCmd {
  freq
  unit: "Hz"
  ac
}

//////////////////////////////////////////////////////////////////////////
// Power Factor
//////////////////////////////////////////////////////////////////////////

// Sensor for AC electric power factor
ElecAcPfSensor : ElecSensor {
  pf
  unit: Unit <invariant> "pf"
  ac
  elecPfScope: ElecPfScope?
  elecPfStandard: ElecPfStandard?
  elecLocation: ElecLocation
}

//////////////////////////////////////////////////////////////////////////
// Power
//////////////////////////////////////////////////////////////////////////

// Sensor for electric power
ElecPowerSensor : ElecSensor <abstract> { power }

// Sensor for average magnitude of AC electric power
ElecAcAvgMagnitudePowerSensor : ElecPowerSensor <abstract> {
  ac
  avg
  magnitude
  elecPowerQuantity: ElecPowerQuantity
  elecLocation: ElecLocation
}

// Sensor for average magnitude of AC electric active power
ElecAcActivePowerSensor : ElecAcAvgMagnitudePowerSensor {
  active
  unit: Unit <quantity:"power"> "kW"
  elecDirection: ElecDirection
}

// Sensor for average magnitude of AC electric reactive power
ElecAcReactivePowerSensor : ElecAcAvgMagnitudePowerSensor {
  reactive
  unit: Unit <quantity:"reactivePower"> "kVAR"
  elecDirection: ElecDirection
}

// Sensor for average magnitude of AC electric apparent power
ElecAcApparentPowerSensor : ElecAcAvgMagnitudePowerSensor {
  apparent
  unit: Unit <quantity:"apparentPower"> "kVA"
  minVal: Number 0.0
}

// Max setpoint for DC electric power
ElecDcPowerMaxSp : ElecPowerMaxSp {
  dc
  elecDirection: ElecDirection
}

// Sensor for DC electric power
ElecDcPowerSensor : ElecPowerSensor {
  dc
  unit: Unit <quantity:"power"> "kW"
  elecDirection: ElecDirection
}

// Max setpoint for electric power
ElecPowerMaxSp : ElecMaxSp <abstract> {
  power
  unit: Unit <quantity:"power"> "kW"
}

// Max setpoint for AC electric power
ElecAcPowerMaxSp : ElecPowerMaxSp <abstract> {
  ac
  elecLocation: ElecLocation
}

// Max setpoint for magnitude of AC electric power
ElecAcMagnitudePowerMaxSp : ElecAcPowerMaxSp <abstract> {
  magnitude
  elecMagnitudeCalc: ElecMagnitudeCalc
}

// Max setpoint for average magnitude of AC electric active power
ElecAcActivePowerMaxSp : ElecAcMagnitudePowerMaxSp {
  avg
  active
  elecDirection: ElecDirection
}

//////////////////////////////////////////////////////////////////////////
// State of Charge
//////////////////////////////////////////////////////////////////////////

// Sensor for DC electric state of charge
ElecDcStateOfChargeSensor : ElecSensor {
  dc
  stateOfCharge
  unit: Unit <invariant> "%"
}

//////////////////////////////////////////////////////////////////////////
// Voltage
//////////////////////////////////////////////////////////////////////////

// Sensor for electric voltage
ElecVoltageSensor : ElecSensor <abstract> { voltage }

// Sensor for AC electric voltage
ElecAcVoltageSensor : ElecVoltageSensor <abstract> {
  ac
  elecSpectralScope: ElecSpectralScope?
  elecHarmonicOrder: Int? <minVal: 2>
  elecLocation: ElecLocation
}

// Sensor for magnitude of AC electric voltage
ElecAcMagnitudeVoltageSensor : ElecAcVoltageSensor <abstract> {
  magnitude
  elecMagnitudeCalc: ElecMagnitudeCalc
  unit: Unit <quantity:"electricPotential"> "V"
  minVal: Number 0.0
}

// Sensor for RMS of AC electric voltage
ElecAcRmsVoltageSensor : ElecAcMagnitudeVoltageSensor { rootMeanSquare }

// Sensor for instantaneous values of an AC electric voltage waveform
ElecAcWaveformVoltageSensor : ElecAcVoltageSensor {
  waveform
  unit: Unit <quantity:"electricPotential"> "V"
}

// Sensor for angle of AC electric voltage
ElecAcAngleVoltageSensor : ElecAcVoltageSensor {
  angle
  unit: "deg"
}

// Sensor for metric of AC electric voltage
ElecAcQualityVoltageSensor : ElecAcVoltageSensor {
  elecQualityMetric: ElecQualityMetric
  unit: Unit <invariant> "%"
}

// Sensor for DC electric voltage
ElecDcVoltageSensor : ElecVoltageSensor { dc }
