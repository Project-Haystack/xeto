//////////////////////////////////////////////////////////////////////////
// Sensors
//////////////////////////////////////////////////////////////////////////

// Sensor for import of AC electric active power demand
ElecAcImportActiveDemandSensor : ElecAcActiveDemandSensor <sugar> { import }

// Sensor for export of AC electric active power demand
ElecAcExportActiveDemandSensor : ElecAcActiveDemandSensor <sugar> { export }

// Sensor for net of AC electric active power demand
ElecAcNetActiveDemandSensor : ElecAcActiveDemandSensor <sugar> { net }

// Sensor for import of AC electric reactive power demand
ElecAcImportReactiveDemandSensor : ElecAcReactiveDemandSensor <sugar> { import }

// Sensor for export of AC electric reactive power demand
ElecAcExportReactiveDemandSensor : ElecAcReactiveDemandSensor <sugar> { export }

// Sensor for net of AC electric reactive power demand
ElecAcNetReactiveDemandSensor : ElecAcReactiveDemandSensor <sugar> { net }

// Sensor for import of AC electric apparent power demand
ElecAcImportApparentDemandSensor : ElecAcApparentDemandSensor <sugar> { import }

// Sensor for export of AC electric apparent power demand
ElecAcExportApparentDemandSensor : ElecAcApparentDemandSensor <sugar> { export }

// Sensor for net of AC electric apparent power demand
ElecAcNetApparentDemandSensor : ElecAcApparentDemandSensor <sugar> { net }

// Sensor for total import of AC electric active power demand
ElecAcTotalImportActiveDemandSensor : ElecAcImportActiveDemandSensor <sugar> { total }

// Sensor for total export of AC electric active power demand
ElecAcTotalExportActiveDemandSensor : ElecAcExportActiveDemandSensor <sugar> { total }

// Sensor for total net of AC electric active power demand
ElecAcTotalNetActiveDemandSensor : ElecAcNetActiveDemandSensor <sugar> { total }

// Sensor for total import of AC electric reactive power demand
ElecAcTotalImportReactiveDemandSensor : ElecAcImportReactiveDemandSensor <sugar> { total }

// Sensor for total export of AC electric reactive power demand
ElecAcTotalExportReactiveDemandSensor : ElecAcExportReactiveDemandSensor <sugar> { total }

// Sensor for total net of AC electric reactive power demand
ElecAcTotalNetReactiveDemandSensor : ElecAcNetReactiveDemandSensor <sugar> { total }

// Sensor for total import of AC electric apparent power demand
ElecAcTotalImportApparentDemandSensor : ElecAcImportApparentDemandSensor <sugar> { total }

// Sensor for total export of AC electric apparent power demand
ElecAcTotalExportApparentDemandSensor : ElecAcExportApparentDemandSensor <sugar> { total }

// Sensor for total net of AC electric apparent power demand
ElecAcTotalNetApparentDemandSensor : ElecAcNetApparentDemandSensor <sugar> { total }

//////////////////////////////////////////////////////////////////////////
// Setpoints
//////////////////////////////////////////////////////////////////////////

// Max setpoint for import of AC electric active power demand
ElecAcImportActiveDemandMaxSp : ElecAcActiveDemandMaxSp <sugar> { import }

// Max setpoint for total import of AC electric active power demand
ElecAcTotalImportActiveDemandMaxSp : ElecAcImportActiveDemandMaxSp <sugar> { total }
