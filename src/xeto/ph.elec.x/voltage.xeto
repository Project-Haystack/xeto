// Sensor for line-to-line average RMS of AC electric voltage
ElecAcLineToLineAvgRmsVoltageSensor : ElecAcRmsVoltageSensor <sugar> { elecLineToLineAvg }

// Sensor for line average RMS of AC electric voltage
ElecAcLineAvgRmsVoltageSensor : ElecAcRmsVoltageSensor <sugar> { elecLineAvg }

// Sensor for line-to-line average metric of AC electric voltage
