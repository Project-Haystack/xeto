cubic_meters_per_second=M3-PER-SEC
cubic_millimeter=MilliM3
cubic_yard=YD3
cycles_per_hour=PER-HR
cycles_per_minute=PER-MIN
// DCIE is a ratio of IT power to total facility power.
data_center_infrastructure_efficiency=UNITLESS
day=DAY
decibel=DeciB
// QUDT DEG is angular degree; phase and ordinary angles use the same unit.
degrees_angular=DEG
degrees_celsius_per_hour=DEG_C-PER-HR
degrees_celsius_per_minute=DEG_C-PER-MIN
degrees_fahrenheit_per_hour=DEG_F-PER-HR
