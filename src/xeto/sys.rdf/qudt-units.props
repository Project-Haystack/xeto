//
// Canonical Xeto sys::Unit name = QUDT resource local name
// Physical units use http://qudt.org/vocab/unit/.
// Xeto currency units use http://qudt.org/vocab/currency/.
//

acre=AC
air_changes_per_hour=PER-HR
ampere=A
ampere_hour=A-HR
ampere_square_meter=A-M2
amperes_per_meter=A-PER-M
amperes_per_square_meter=A-PER-M2
atmosphere=ATM
bar=BAR
btu=BTU_IT
btu_per_pound=BTU_IT-PER-LB
btu_per_square_foot=BTU_IT-PER-FT2
btus_per_hour=BTU_IT-PER-HR
btu_per_pound_dry_air=BTU_IT-PER-LB
byte=BYTE
calorie=CAL_TH
calorie_per_gram=CAL_TH-PER-GM
candela=CD
candelas_per_square_meter=CD-PER-M2
candels_per_square_foot=CD-PER-FT2
celsius=DEG_C
// Temperature intervals: one delta degree Celsius equals one kelvin.
celsius_degrees=K
centimeter=CentiM
centimeters_of_mercury=CentiM_HG
centimeters_of_water=CentiM_H2O
// QUDT RT is Register Ton, a volume of exactly 100 cubic feet.
centum_cubic_feet=RT
coefficient_of_performance=NUM
coulomb=C
cubic_centimeter=CentiM3
cubic_feet_per_hour=FT3-PER-HR
cubic_feet_per_minute=FT3-PER-MIN
