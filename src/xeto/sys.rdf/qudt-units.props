burundi_franc=BIF
canadian_dollar=CAD
cape_verde_escudo=CVE
cayman_islands_dollar=KYD
// Xeto's `cedi` is the Ghanaian cedi, identified by GHS.
cedi=GHS
cfp_franc=XPF
chilean_peso=CLP
// CNY is commonly called the Chinese yuan or renminbi yuan.
