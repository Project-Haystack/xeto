// Currency units use the QUDT currency namespace rather than the unit namespace.
// Keys remain the canonical names in the pinned Xeto catalog. Comments call
// out dated or ambiguous Xeto names; the ISO code identifies the mapped currency.
afghani=AFN
algerian_dinar=DZD
argentine_peso=ARS
armenian_dram=AMD
aruban_guilder_florin=AWG
australian_dollar=AUD
azerbaijanian_manat=AZN
bahamian_dollar=BSD
bahraini_dinar=BHD
// Xeto's `baht` is the Thai baht, identified by THB.
baht=THB
balboa=PAB
barbados_dollar=BBD
belize_dollar=BZD
bermudian_dollar=BMD
boliviano=BOB
brazilian_real=BRL
