degrees_kelvin_per_minute=K-PER-MIN
degrees_kelvin_per_second=K-PER-SEC
degrees_phase=DEG
fahrenheit=DEG_F
// One delta degree Fahrenheit has the same interval size as one degree Rankine.
fahrenheit_degrees=DEG_R
farad=FARAD
feet_per_minute=FT-PER-MIN
feet_per_second=FT-PER-SEC
// Xeto's fluid ounce conversion is the US liquid fluid ounce.
fluid_ounce=OZ_VOL_US
foot=FT
foot_pounds_per_second=FT-LB_F-PER-SEC
footcandle=FC
gallon=GAL_US
gallons_per_hour=GAL_US-PER-HR
gallons_per_minute=GAL_US-PER-MIN
gigabyte=GibiBYTE
