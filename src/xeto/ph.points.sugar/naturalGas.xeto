//////////////////////////////////////////////////////////////////////////
// Flow
//////////////////////////////////////////////////////////////////////////

// Sensor for volumetric flow of natural gas
NaturalGasFlowSensor : FluidVolumetricFlowSensor {
  naturalGas
  unit: Unit "cfm"
}

// Setpoint for volumetric flow of natural gas
NaturalGasFlowSp : FluidVolumetricFlowSp {
  naturalGas
  unit: Unit "cfm"
}

//////////////////////////////////////////////////////////////////////////
// Volume
//////////////////////////////////////////////////////////////////////////

// Sensor for volumetric consumption of natural gas
NaturalGasVolumeSensor : FluidVolumeSensor {
  naturalGas
  unit: Unit "Ccf"
}

// Setpoint for volumetric consumption of natural gas
NaturalGasVolumeSp : FluidVolumeSp {
  naturalGas
  unit: Unit "Ccf"
}

//////////////////////////////////////////////////////////////////////////
// Energy
//////////////////////////////////////////////////////////////////////////

// Sensor for energy consumption of natural gas
NaturalGasEnergySensor : FluidEnergySensor {
  naturalGas
  unit: Unit "Ccf_natural_gas"
}

// Setpoint for energy consumption of natural gas
NaturalGasEnergySp : FluidEnergySp {
  naturalGas
  unit: Unit "Ccf_natural_gas"
}

