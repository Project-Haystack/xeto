//////////////////////////////////////////////////////////////////////////
// Chilled Water Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for chilled water leaving pressure
ChilledWaterLeavingPressureSensor : WaterPressureSensor <sugar> { chilled, leaving }

// Sensor for chilled water entering pressure
ChilledWaterEnteringPressureSensor : WaterPressureSensor <sugar> { chilled, entering }

// Setpoint for chilled water leaving pressure
ChilledWaterLeavingPressureSp : WaterPressureSp <sugar> { chilled, leaving }

// Setpoint for chilled water entering pressure
ChilledWaterEnteringPressureSp : WaterPressureSp <sugar> { chilled, entering }

//////////////////////////////////////////////////////////////////////////
// Hot Water Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for hot water leaving pressure
HotWaterLeavingPressureSensor : WaterPressureSensor <sugar> { hot, leaving }

// Sensor for hot water entering pressure
HotWaterEnteringPressureSensor : WaterPressureSensor <sugar> { hot, entering }

// Setpoint for hot water leaving pressure
HotWaterLeavingPressureSp : WaterPressureSp <sugar> { hot, leaving }

// Setpoint for hot water entering pressure
HotWaterEnteringPressureSp : WaterPressureSp <sugar> { hot, entering }
