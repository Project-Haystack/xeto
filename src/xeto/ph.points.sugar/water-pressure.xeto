//////////////////////////////////////////////////////////////////////////
// Chilled Water Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for chilled water leaving pressure
ChilledWaterLeavingPressureSensor : PipeWaterPressureSensor { chilled, leaving }

// Sensor for chilled water entering pressure
ChilledWaterEnteringPressureSensor : PipeWaterPressureSensor { chilled, entering }

// Setpoint for chilled water leaving pressure
ChilledWaterLeavingPressureSp : PipeWaterPressureSp { chilled, leaving }

// Setpoint for chilled water entering pressure
ChilledWaterEnteringPressureSp : PipeWaterPressureSp { chilled, entering }

//////////////////////////////////////////////////////////////////////////
// Hot Water Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for hot water leaving pressure
HotWaterLeavingPressureSensor : PipeWaterPressureSensor { hot, leaving }

// Sensor for hot water entering pressure
HotWaterEnteringPressureSensor : PipeWaterPressureSensor { hot, entering }

// Setpoint for hot water leaving pressure
HotWaterLeavingPressureSp : PipeWaterPressureSp { hot, leaving }

// Setpoint for hot water entering pressure
HotWaterEnteringPressureSp : PipeWaterPressureSp { hot, entering }
