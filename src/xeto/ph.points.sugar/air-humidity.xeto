//////////////////////////////////////////////////////////////////////////
// Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for relative humidity in discharge duct
DischargeAirHumiditySensor : DuctAirHumiditySensor { discharge }

// Setpoint for relative humidity in discharge duct
DischargeAirHumiditySp : DuctAirHumiditySp { discharge }

//////////////////////////////////////////////////////////////////////////
// Outdoor
//////////////////////////////////////////////////////////////////////////

// Sensor for relative humidity in outside duct
OutsideAirHumiditySensor : DuctAirHumiditySensor { outside }

// Setpoint for relative humidity in outside duct
OutsideAirHumiditySp : DuctAirHumiditySp { outside }

//////////////////////////////////////////////////////////////////////////
// Zone
//////////////////////////////////////////////////////////////////////////

// Sensor for relative humidity in the zone
ZoneAirHumiditySensor : AirHumiditySensor { zone }

// Setpoint for relative humidity in the zone
ZoneAirHumiditySp : AirHumiditySp { zone }

