//////////////////////////////////////////////////////////////////////////
// Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of discharge duct
DischargeAirTempSensor : DuctAirTempSensor <sugar> { discharge }

// Setpoint for drybulb air temperature of discharge duct
DischargeAirTempSp : DuctAirTempSp <sugar> { discharge }

//////////////////////////////////////////////////////////////////////////
// Economizer
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of economizer duct.
// Used when there are separate ducts for minimum fresh air vs economizing.
EconomizerAirTempSensor : DuctAirTempSensor <sugar> { economizer }

//////////////////////////////////////////////////////////////////////////
// Inlet
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of inlet duct
InletAirTempSensor : DuctAirTempSensor <sugar> { inlet }

// Setpoint for drybulb air temperature of inlet duct
InletAirTempSp : DuctAirTempSp <sugar> { inlet }

//////////////////////////////////////////////////////////////////////////
// Mixed
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of mixed duct
MixedAirTempSensor : DuctAirTempSensor <sugar> { mixed }

// Setpoint for drybulb air temperature of mixed duct
MixedAirTempSp : DuctAirTempSp <sugar> { mixed }

//////////////////////////////////////////////////////////////////////////
// Outside
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of outside duct.
// Used when there is one duct for both minimum fresh air and economizing.
OutsideAirTempSensor : DuctAirTempSensor <sugar> { outside }

//////////////////////////////////////////////////////////////////////////
// Return
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of return duct
ReturnAirTempSensor : DuctAirTempSensor <sugar> { return }

// Setpoint for drybulb air temperature of return duct
ReturnAirTempSp : DuctAirTempSp <sugar> { return }

//////////////////////////////////////////////////////////////////////////
// Ventilation
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature of ventilation or minimum fresh air duct.
// Used when there are separate ducts for minimum fresh air vs economizing.
VentilationAirTempSensor : DuctAirTempSensor <sugar> { ventilation }

