// Sensor for modulating damper position.  Position is measured as a
// percentage where 0% is closed and 100% is fully open.
DamperModulatingSensor : ActuatorModulatingSensor {
  air
  damper
}

// Command for modulating damper position.  Position is measured as a
// percentage where 0% is closed and 100% is fully open.
DamperModulatingCmd : ActuatorModulatingCmd {
  air
  damper
}

//////////////////////////////////////////////////////////////////////////
// Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
DischargeDamperModulatingSensor : DamperModulatingSensor { discharge }

// Command for modulating damper position in a discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
DischargeDamperModulatingCmd : DamperModulatingCmd { discharge }

//////////////////////////////////////////////////////////////////////////
// ColdDeck Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a cold deck discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ColdDeckDischargeDamperModulatingSensor : DischargeDamperModulatingSensor { coldDeck }

// Command for modulating damper position in a cold deck discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ColdDeckDischargeDamperModulatingCmd : DischargeDamperModulatingCmd { coldDeck }

//////////////////////////////////////////////////////////////////////////
// HotDeck Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a hot deck discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
HotDeckDischargeDamperModulatingSensor : DischargeDamperModulatingSensor { hotDeck }

// Command for modulating damper position in a hot deck discharge duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
HotDeckDischargeDamperModulatingCmd : DischargeDamperModulatingCmd { hotDeck }

//////////////////////////////////////////////////////////////////////////
// Economizing
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in an economizing duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
// Used when there are separate ducts for minimum fresh air vs economizing.
EconomizingDamperModulatingSensor : DamperModulatingSensor { economizing }

// Command for modulating damper position in an economizing duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
// Used when there are separate ducts for minimum fresh air vs economizing.
EconomizingDamperModulatingCmd : DamperModulatingCmd { economizing }

//////////////////////////////////////////////////////////////////////////
// Exhaust
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in an exhaust duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ExhaustDamperModulatingSensor : DamperModulatingSensor { exhaust }

// Command for modulating damper position in an exhaust duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ExhaustDamperModulatingCmd : DamperModulatingCmd { exhaust }

//////////////////////////////////////////////////////////////////////////
// Mixed
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a mixed air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
MixedDamperModulatingSensor : DamperModulatingSensor { mixed }

// Command for modulating damper position in a mixed air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
MixedDamperModulatingCmd : DamperModulatingCmd { mixed }

//////////////////////////////////////////////////////////////////////////
// Outside
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in an outside air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
// Used when there one duct for both minimum fresh air and economizing.
OutsideDamperModulatingSensor : DamperModulatingSensor { outside }

// Command for modulating damper position in an outside air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
// Used when there one duct for both minimum fresh air and economizing.
OutsideDamperModulatingCmd : DamperModulatingCmd { outside }

//////////////////////////////////////////////////////////////////////////
// Return
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a return air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ReturnDamperModulatingSensor : DamperModulatingSensor { return }

// Command for modulating damper position in a return air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
ReturnDamperModulatingCmd : DamperModulatingCmd { return }

//////////////////////////////////////////////////////////////////////////
// Ventilation
//////////////////////////////////////////////////////////////////////////

// Sensor for modulating damper position in a ventilation or minimum fresh
// air duct.  Position is measured as a percentage where 0% is closed and
// 100% is fully open.  Used when there are separate ducts for minimum fresh
// air vs economizing.
VentilationDamperModulatingSensor : DamperModulatingSensor { ventilation }

// Command for modulating damper position in a ventilation or minimum fresh
// air duct.  Position is measured as a percentage where 0% is closed and
// 100% is fully open.  Used when there are separate ducts for minimum fresh
// air vs economizing.
VentilationDamperModulatingCmd : DamperModulatingCmd { ventilation }

