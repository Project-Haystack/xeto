//////////////////////////////////////////////////////////////////////////
// Discharge Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a discharge air duct
DischargeAirDamperOpenSensor : DuctAirDamperOpenSensor { discharge }

// Command for open/close state of a damper in a discharge air duct
DischargeAirDamperOpenCmd : DuctAirDamperOpenCmd { discharge }

// Sensor for modulating position of a damper in a discharge air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.
DischargeAirDamperModulatingSensor : DuctAirDamperModulatingSensor { discharge }

// Command for modulating position of a damper in a discharge air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.
DischargeAirDamperModulatingCmd : DuctAirDamperModulatingCmd { discharge }

//////////////////////////////////////////////////////////////////////////
// Cold Deck Discharge Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a cold deck discharge air duct
ColdDeckDischargeAirDamperOpenSensor : DischargeAirDamperOpenSensor { coldDeck }

// Command for open/close state of a damper in a cold deck discharge air duct
ColdDeckDischargeAirDamperOpenCmd : DischargeAirDamperOpenCmd { coldDeck }

// Sensor for modulating position of a damper in a cold deck discharge air
// duct.  Position is measured as a percentage where 0% is closed and 100% is
// fully open.
ColdDeckDischargeAirDamperModulatingSensor : DischargeAirDamperModulatingSensor { coldDeck }

// Command for modulating position of a damper in a cold deck discharge air
// duct.  Position is measured as a percentage where 0% is closed and 100% is
// fully open.
ColdDeckDischargeAirDamperModulatingCmd : DischargeAirDamperModulatingCmd { coldDeck }

//////////////////////////////////////////////////////////////////////////
// Hot Deck Discharge Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a hot deck discharge air duct
HotDeckDischargeAirDamperOpenSensor : DischargeAirDamperOpenSensor { hotDeck }

// Command for open/close state of a damper in a hot deck discharge air duct
HotDeckDischargeAirDamperOpenCmd : DischargeAirDamperOpenCmd { hotDeck }

// Sensor for modulating position of a damper in a hot deck discharge air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.
HotDeckDischargeAirDamperModulatingSensor : DischargeAirDamperModulatingSensor { hotDeck }

// Command for modulating position of a damper in a hot deck discharge air
// duct.  Position is measured as a percentage where 0% is closed and 100% is
// fully open.
HotDeckDischargeAirDamperModulatingCmd : DischargeAirDamperModulatingCmd { hotDeck }

//////////////////////////////////////////////////////////////////////////
// Economizer Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in an economizer air duct
EconomizerAirDamperOpenSensor : DuctAirDamperOpenSensor { economizer }

// Command for open/close state of a damper in an economizer air duct
EconomizerAirDamperOpenCmd : DuctAirDamperOpenCmd { economizer }

// Sensor for modulating position of a damper in an economizer air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.  Used when there are separate ducts for minimum fresh air vs
// economizing.
EconomizerAirDamperModulatingSensor : DuctAirDamperModulatingSensor { economizer }

// Command for modulating position of a damper in an economizer air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.  Used when there are separate ducts for minimum fresh air vs
// economizing.
EconomizerAirDamperModulatingCmd : DuctAirDamperModulatingCmd { economizer }

//////////////////////////////////////////////////////////////////////////
// Exhaust Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in an exhaust air duct
ExhaustAirDamperOpenSensor : DuctAirDamperOpenSensor { exhaust }

// Command for open/close state of a damper in an exhaust air duct
ExhaustAirDamperOpenCmd : DuctAirDamperOpenCmd { exhaust }

// Sensor for modulating position of a damper in an exhaust air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
ExhaustAirDamperModulatingSensor : DuctAirDamperModulatingSensor { exhaust }

// Command for modulating position of a damper in an exhaust air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.
ExhaustAirDamperModulatingCmd : DuctAirDamperModulatingCmd { exhaust }

//////////////////////////////////////////////////////////////////////////
// Mixed Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a mixed air duct
MixedAirDamperOpenSensor : DuctAirDamperOpenSensor { mixed }

// Command for open/close state of a damper in a mixed air duct
MixedAirDamperOpenCmd : DuctAirDamperOpenCmd { mixed }

// Sensor for modulating position of a damper in a mixed air duct.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
MixedAirDamperModulatingSensor : DuctAirDamperModulatingSensor { mixed }

// Command for modulating position of a damper in a mixed air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
MixedAirDamperModulatingCmd : DuctAirDamperModulatingCmd { mixed }

//////////////////////////////////////////////////////////////////////////
// Outside Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in an outside air duct
OutsideAirDamperOpenSensor : DuctAirDamperOpenSensor { outside }

// Command for open/close state of a damper in an outside air duct
OutsideAirDamperOpenCmd : DuctAirDamperOpenCmd { outside }

// Sensor for modulating position of a damper in an outside air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.  Used when there is one duct for both minimum fresh air and
// economizing.
OutsideAirDamperModulatingSensor : DuctAirDamperModulatingSensor { outside }

// Command for modulating position of a damper in an outside air duct.
// Position is measured as a percentage where 0% is closed and 100% is fully
// open.  Used when there is one duct for both minimum fresh air and
// economizing.
OutsideAirDamperModulatingCmd : DuctAirDamperModulatingCmd { outside }

//////////////////////////////////////////////////////////////////////////
// Return Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a return air duct
ReturnAirDamperOpenSensor : DuctAirDamperOpenSensor { return }

// Command for open/close state of a damper in a return air duct
ReturnAirDamperOpenCmd : DuctAirDamperOpenCmd { return }

// Sensor for modulating position of a damper in a return air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
ReturnAirDamperModulatingSensor : DuctAirDamperModulatingSensor { return }

// Command for modulating position of a damper in a return air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
ReturnAirDamperModulatingCmd : DuctAirDamperModulatingCmd { return }

//////////////////////////////////////////////////////////////////////////
// Ventilation Air
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a ventilation or minimum fresh air duct
VentilationAirDamperOpenSensor : DuctAirDamperOpenSensor { ventilation }

// Command for open/close state of a damper in a ventilation or minimum fresh air duct
VentilationAirDamperOpenCmd : DuctAirDamperOpenCmd { ventilation }

// Sensor for modulating position of a damper in a ventilation or minimum fresh
// air duct.  Position is measured as a percentage where 0% is closed and 100%
// is fully open.  Used when there are separate ducts for minimum fresh air vs
// economizing.
VentilationAirDamperModulatingSensor : DuctAirDamperModulatingSensor { ventilation }

// Command for modulating position of a damper in a ventilation or minimum
// fresh air duct.  Position is measured as a percentage where 0% is closed and
// 100% is fully open.  Used when there are separate ducts for minimum fresh
// air vs economizing.
VentilationAirDamperModulatingCmd : DuctAirDamperModulatingCmd { ventilation }
