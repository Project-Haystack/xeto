// Sensor that measures temperature of a heatsink
HeatsinkTempSensor : SurfaceTempSensor <sugar> { heatsink }

// Sensor that measures temperature of an electric cable
ElecCableTempSensor : SurfaceTempSensor <sugar> {
  elec
  cable
}

// Sensor that measures temperature of a motor
MotorTempSensor : SurfaceTempSensor <sugar> { motor }

// Sensor that measures temperature of a motor winding
MotorWindingTempSensor : MotorTempSensor { winding }

// Sensor that measures temperature of a motor bearing
MotorBearingTempSensor : MotorTempSensor { bearing }

//////////////////////////////////////////////////////////////////////////
// EVSE
//////////////////////////////////////////////////////////////////////////

// Sensor that measures temperature of an EVSE cable
EvseCableTempSensor : ElecCableTempSensor { evse }

// Sensor that measures temperature of an EVSE connector
EvseConnectorTempSensor : SurfaceTempSensor <sugar> { evseConnector }
