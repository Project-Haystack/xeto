pragma: Lib <
  doc: "Project haystack sugar points library"
  version: BuildVar "ph.version"
  maturity: BuildVar "ph.maturity"
  depends: {
    { lib: "sys",       versions: BuildVar "ph.depend" }
    { lib: "ph",        versions: BuildVar "ph.depend" }
    { lib: "ph.points", versions: BuildVar "ph.depend" }
  }
  categories: {"ph"}
  license: BuildVar "ph.license"
  org: {
   dis: BuildVar "ph.org.dis"
   uri: BuildVar "ph.org.uri"
  }
  vcs: {
    type: BuildVar "ph.vcs.type"
    uri:  BuildVar "ph.vcs.uri"
  }
>

