//////////////////////////////////////////////////////////////////////////
// Flow
//////////////////////////////////////////////////////////////////////////

// Sensor for volumetric flow of water
WaterFlowSensor : FluidVolumetricFlowSensor {
  water
  unit: Unit "gal/min"
}

// Setpoint for volumetric flow of water
WaterFlowSp : FluidVolumetricFlowSp {
  water
  unit: Unit "gal/min"
}

// Sensor for volumetric flow of water in a pipe
PipeWaterFlowSensor : WaterFlowSensor {
  pipeSection: PipeSection
}

// Setpoint for volumetric flow of water in a pipe
PipeWaterFlowSp : WaterFlowSp {
  pipeSection: PipeSection
}

//////////////////////////////////////////////////////////////////////////
// Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for water pressure
WaterPressureSensor : FluidPressureSensor {
  water
  unit: Unit "psi"
}

// Setpoint for water pressure
WaterPressureSp : FluidPressureSp {
  water
  unit: Unit "psi"
}

// Sensor for water pressure in a pipe
PipeWaterPressureSensor : WaterPressureSensor {
  pipeSection: PipeSection
}

// Setpoint for water pressure in a pipe
PipeWaterPressureSp : WaterPressureSp {
  pipeSection: PipeSection
}

//////////////////////////////////////////////////////////////////////////
// Temp
//////////////////////////////////////////////////////////////////////////

// Sensor for water temperature
WaterTempSensor : FluidTempSensor { water }

// Setpoint for water temperature
WaterTempSp : FluidTempSp { water }

// Sensor for water temperature in a pipe
PipeWaterTempSensor : WaterTempSensor {
  pipeSection: PipeSection
}

// Setpoint for water temperature in a pipe
PipeWaterTempSp : WaterTempSp {
  pipeSection: PipeSection
}

//////////////////////////////////////////////////////////////////////////
// Volume
//////////////////////////////////////////////////////////////////////////

// Point associated with volumetric consumption of water
WaterVolumePoint : NumberPoint <abstract> {
  fluid
  water
  volume
  unit: Unit <quantity:"volume"> "gal"
}

// Sensor for volumetric consumption of water
WaterVolumeSensor : WaterVolumePoint & SensorPoint

// Setpoint for volumetric consumption of water
WaterVolumeSp : WaterVolumePoint & SpPoint

