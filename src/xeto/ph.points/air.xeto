//////////////////////////////////////////////////////////////////////////
// Flow
//////////////////////////////////////////////////////////////////////////

// Sensor for volumetric air flow
AirFlowSensor : FluidVolumetricFlowSensor {
  air
  unit: Unit "cfm"
}

// Setpoint for volumetric air flow
AirFlowSp : FluidVolumetricFlowSp {
  air
  unit: Unit "cfm"
}

// Sensor for volumetric air flow in a duct
DuctAirFlowSensor : AirFlowSensor {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Setpoint for volumetric air flow in a duct
DuctAirFlowSp : AirFlowSp {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

//////////////////////////////////////////////////////////////////////////
// Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for static air pressure
AirPressureSensor : FluidPressureSensor {
  air
  unit: Unit "inH₂O"
}

// Setpoint for static air pressure
AirPressureSp : FluidPressureSp {
  air
  unit: Unit "inH₂O"
}

// Sensor for static air pressure in a duct
DuctAirPressureSensor : AirPressureSensor {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Setpoint for static air pressure in a duct
DuctAirPressureSp : AirPressureSp {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

//////////////////////////////////////////////////////////////////////////
// Temp
//////////////////////////////////////////////////////////////////////////

// Sensor for drybulb air temperature
AirTempSensor : FluidTempSensor { air }

// Setpoint for drybulb air temperature
AirTempSp : FluidTempSp { air }

// Sensor for drybulb air temperature in a duct
DuctAirTempSensor : AirTempSensor {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Setpoint for drybulb air temperature in a duct
DuctAirTempSp : AirTempSp {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Drybulb air temperature sensor for zone
ZoneAirTempSensor : AirTempSensor { zone }

// Setpoint for drybulb air temperature zone
ZoneAirTempSp : AirTempSp { zone }

// Sensor for air temperature inside an enclosure
EnclosureAirTempSensor : AirTempSensor { enclosure }

//////////////////////////////////////////////////////////////////////////
// Humidity
//////////////////////////////////////////////////////////////////////////

// Point associated with relative humidity; measure of moisture in the air
AirHumidityPoint : NumberPoint <abstract> {
  air
  humidity
  pointQuantity: Humidity
  unit: Unit <invariant> "%RH"
}

// Sensor for relative humidity
AirHumiditySensor : AirHumidityPoint & SensorPoint <abstract>

// Setpoint for relative humidity
AirHumiditySp : AirHumidityPoint & SpPoint <abstract>

// Sensor for relative humidity in a duct
DuctAirHumiditySensor : AirHumiditySensor {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Setpoint for relative humidity in a duct
DuctAirHumiditySp : AirHumiditySp {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Sensor for relative humidity in the zone
ZoneAirHumiditySensor : AirHumiditySensor { zone }

// Setpoint for relative humidity in the zone
ZoneAirHumiditySp : AirHumiditySp { zone }

