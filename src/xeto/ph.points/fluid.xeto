//////////////////////////////////////////////////////////////////////////
// Flow
//////////////////////////////////////////////////////////////////////////

// Point associated with flow of fluid
FluidFlowPoint : NumberPoint <abstract> {
  flow
  pointQuantity: Flow
  pointSubject: Fluid
}

// Point associated with volumetric flow of fluid
FluidVolumetricFlowPoint : FluidFlowPoint <abstract> {
  volume
  pointQuantity: VolumetricFlow
  unit: Unit <quantity:"volumetricFlow">
}

// Sensor for volumetric flow of fluid
FluidVolumetricFlowSensor : FluidVolumetricFlowPoint & SensorPoint

// Setpoint for volumetric flow of fluid
FluidVolumetricFlowSp : FluidVolumetricFlowPoint & SpPoint

// Point associated with mass flow of fluid
FluidMassFlowPoint : FluidFlowPoint <abstract> {
  mass
  pointQuantity: MassFlow
  unit: Unit <quantity:"massFlow">
}

// Sensor for mass flow of fluid
FluidMassFlowSensor : FluidMassFlowPoint & SensorPoint

// Setpoint for mass flow of fluid
FluidMassFlowSp : FluidMassFlowPoint & SpPoint

//////////////////////////////////////////////////////////////////////////
// Pressure
//////////////////////////////////////////////////////////////////////////

// Point associated with fluid pressure
FluidPressurePoint : NumberPoint <abstract> {
  pressure
  pointQuantity: Pressure
  pointSubject: Fluid
  unit: Unit <quantity:"pressure">
}

// Sensor for fluid pressure
FluidPressureSensor : FluidPressurePoint & SensorPoint

// Setpoint for fluid pressure
FluidPressureSp : FluidPressurePoint & SpPoint

//////////////////////////////////////////////////////////////////////////
// Temp
//////////////////////////////////////////////////////////////////////////

// Point associated with fluid temperature
FluidTempPoint : NumberPoint <abstract> {
  temp
  pointQuantity: Temp
  pointSubject: Fluid
  unit: Unit <quantity:"temperature"> "°F"
}

// Sensor for fluid temperature
FluidTempSensor : FluidTempPoint & SensorPoint

// Setpoint for fluid temperature
FluidTempSp : FluidTempPoint & SpPoint

//////////////////////////////////////////////////////////////////////////
// Volume
//////////////////////////////////////////////////////////////////////////

// Point associated with volumetric consumption of fluid
FluidVolumePoint : NumberPoint <abstract> {
  volume
  pointQuantity: Volume
  pointSubject: Fluid
  unit: Unit <quantity:"volume">
}

// Sensor for volumetric consumption of fluid
FluidVolumeSensor : FluidVolumePoint & SensorPoint

// Setpoint for volumetric consumption of fluid
FluidVolumeSp : FluidVolumePoint & SpPoint

//////////////////////////////////////////////////////////////////////////
// Energy
//////////////////////////////////////////////////////////////////////////

// Point associated with energy consumption of fluid
FluidEnergyPoint : NumberPoint <abstract> {
  energy
  pointQuantity: Energy
  pointSubject: Fluid
  unit: Unit <quantity:"energy">
}

// Sensor for energy consumption of fluid
FluidEnergySensor : FluidEnergyPoint & SensorPoint

// Setpoint for energy consumption of fluid
FluidEnergySp : FluidEnergyPoint & SpPoint

