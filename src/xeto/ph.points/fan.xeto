// Point associated with a fan
FanPoint : Point <abstract> {
  air
  fan
}

// Command to permit/prohibit a fan to run.
// Used as an interlock with a run command.
FanEnableCmd : FanPoint & MotorEnableCmd

// Sensor for on/off state of a fan
FanRunSensor : FanPoint & MotorRunSensor

// On/off command to run a fan
FanRunCmd : FanPoint & MotorRunCmd

// Sensor for enumerated fan speed level.  The enum value indicates the
// current speed level, where the first value is off and subsequent values
// increase from slowest to highest speed.
FanSpeedEnumSensor : FanPoint & MotorSpeedEnumSensor

// Command for enumerated fan speed level.  The enum value indicates the
// current speed level, where the first value is off and subsequent values
// increase from slowest to highest speed.
FanSpeedEnumCmd : FanPoint & MotorSpeedEnumCmd

// Sensor for modulating speed of a fan.  Speed is measured as a
// percentage where 0% is off and 100% is full speed.
FanSpeedModulatingSensor : FanPoint & MotorSpeedModulatingSensor

// Command for modulating speed of a fan.  Speed is measured as a
// percentage where 0% is off and 100% is full speed.
FanSpeedModulatingCmd : FanPoint & MotorSpeedModulatingCmd

//////////////////////////////////////////////////////////////////////////
// Duct
//////////////////////////////////////////////////////////////////////////

// Point associated with a fan in a duct section
DuctFanPoint : FanPoint <abstract> {
  ductSection: DuctSection
  ductDeck: DuctDeck?
}

// Command to permit/prohibit a fan in a duct section to run.
// Used as an interlock with a run command.
DuctFanEnableCmd : DuctFanPoint & FanEnableCmd

// Sensor for on/off state of a fan in a duct section
DuctFanRunSensor : DuctFanPoint & FanRunSensor

// On/off command to run a fan in a duct section
DuctFanRunCmd : DuctFanPoint & FanRunCmd

// Sensor for enumerated speed level of a fan in a duct section
DuctFanSpeedEnumSensor : DuctFanPoint & FanSpeedEnumSensor

// Command for enumerated speed level of a fan in a duct section
DuctFanSpeedEnumCmd : DuctFanPoint & FanSpeedEnumCmd

// Sensor for modulating speed of a fan in a duct section
DuctFanSpeedModulatingSensor : DuctFanPoint & FanSpeedModulatingSensor

// Command for modulating speed of a fan in a duct section
DuctFanSpeedModulatingCmd : DuctFanPoint & FanSpeedModulatingCmd
