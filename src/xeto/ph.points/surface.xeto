// Point associated with surface temperature
SurfaceTempPoint : NumberPoint <abstract> {
  surface
  temp
  pointQuantity: Temp
  unit: Unit <quantity:"temperature"> "°F"
}

// Sensor that measures surface temperature
SurfaceTempSensor : SurfaceTempPoint & SensorPoint
