// Sensor for open/close state of a valve
ValveOpenSensor : ActuatorOpenSensor {
  valve
  fluid: Fluid
}

// Command for open/close state of a valve
ValveOpenCmd : ActuatorOpenCmd {
  valve
  fluid: Fluid
}

// Sensor for modulating position of a valve.  Position is measured as a
// percentage where 0% is closed and 100% is fully open.
ValveModulatingSensor : ActuatorModulatingSensor {
  valve
  fluid: Fluid
}

// Command for modulating position of a valve.  Position is measured as a
// percentage where 0% is closed and 100% is fully open.
ValveModulatingCmd : ActuatorModulatingCmd {
  valve
  fluid: Fluid
}

//////////////////////////////////////////////////////////////////////////
// Water
//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a valve in a water pipe
WaterValveOpenSensor : ValveOpenSensor { water }

// Command for open/close state of a valve in a water pipe
WaterValveOpenCmd : ValveOpenCmd { water }

// Sensor for modulating position of a valve in a water pipe.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
WaterValveModulatingSensor : ValveModulatingSensor { water }

// Command for modulating position of a valve in a water pipe.  Position is
// measured as a percentage where 0% is closed and 100% is fully open.
WaterValveModulatingCmd : ValveModulatingCmd { water }
