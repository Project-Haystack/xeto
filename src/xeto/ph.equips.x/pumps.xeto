// Pump circulating hot water
HotWaterPump : Pump <sugar> { hot, water }

// Pump circulating chilled water
ChilledWaterPump : Pump <sugar> { chilled, water }

// Pump circulating condenser water
CondenserWaterPump : Pump <sugar> { condenser, water }
