// Water flow meter
WaterMeter : FlowMeter <sugar> { water }

// Domestic water flow meter
DomesticWaterMeter : WaterMeter <sugar> { domestic }

// Hot water flow meter
HotWaterMeter : WaterMeter <sugar> { hot }

// Chilled water flow meter
ChilledWaterMeter : WaterMeter <sugar> { chilled }

// Steam flow meter
SteamMeter : FlowMeter <sugar> { steam }

// Natural gas flow meter
NaturalGasMeter : FlowMeter <sugar> { naturalGas }
