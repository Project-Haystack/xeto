// Duct to access fresh outside air only for economizing, not ventilation
EconomizerDuct: Duct <sugar> { economizer }

// Duct for exhausting combustion
FlueDuct: Duct <sugar> { flue }

// Duct with air entering an equipment
InletDuct: Duct <sugar> { inlet }

// Duct to access fresh outside air only for ventilation, not economizing
VentilationDuct: Duct <sugar> { ventilation }

// Duct to access fresh outside air for both ventilation and economizer.
OutsideDuct: Duct <sugar> { outside }

// Duct for air leaving an equipment
DischargeDuct: Duct <sugar> { discharge }

// Duct used to expel air back outside
ExhaustDuct: Duct <sugar> { exhaust }

// Duct returning air back to equipment
ReturnDuct: Duct <sugar> { return }

// Duct where fresh outside air and return air is mixed together
MixedDuct: Duct <sugar> { mixed }

// Discharge duct for cooling
ColdDeckDischargeDuct: DischargeDuct { coldDeck }

// Discharge duct for heating
HotDeckDischargeDuct: DischargeDuct { hotDeck }

// Discharge duct which by-passes both heating and cooling coils
NeutralDeckDischargeDuct: DischargeDuct { neutralDeck }
