//////////////////////////////////////////////////////////////////////////

// Sensor for open/close state of a damper in a return air duct
ReturnAirDamperOpenSensor : DuctAirDamperOpenSensor <sugar> { return }

// Command for open/close state of a damper in a return air duct
ReturnAirDamperOpenCmd : DuctAirDamperOpenCmd <sugar> { return }

// Sensor for modulating position of a damper in a return air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
ReturnAirDamperModulatingSensor : DuctAirDamperModulatingSensor <sugar> { return }

// Command for modulating position of a damper in a return air duct.  Position
// is measured as a percentage where 0% is closed and 100% is fully open.
ReturnAirDamperModulatingCmd : DuctAirDamperModulatingCmd <sugar> { return }

