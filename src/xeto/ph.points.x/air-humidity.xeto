//////////////////////////////////////////////////////////////////////////
// Discharge
//////////////////////////////////////////////////////////////////////////

// Sensor for relative humidity in discharge duct
DischargeAirHumiditySensor : DuctAirHumiditySensor <sugar> { discharge }

// Setpoint for relative humidity in discharge duct
DischargeAirHumiditySp : DuctAirHumiditySp <sugar> { discharge }

//////////////////////////////////////////////////////////////////////////
// Outdoor
//////////////////////////////////////////////////////////////////////////

// Sensor for relative humidity in outside duct
OutsideAirHumiditySensor : DuctAirHumiditySensor <sugar> { outside }

// Setpoint for relative humidity in outside duct
OutsideAirHumiditySp : DuctAirHumiditySp <sugar> { outside }

