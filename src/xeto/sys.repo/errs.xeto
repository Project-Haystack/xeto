// Lib name could not be resolved in the repo
UnknownLibErr: ApiErr {
  // Dotted lib name which could not be resolved
  lib: Str
}

// Lib name is available in the repo, but not the requested version
UnknownLibVersionErr: ApiErr {
  // Dotted lib name requested
  lib: Str

  // Version which is not available
  version: Version
}
