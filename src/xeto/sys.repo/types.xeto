// Response from [repoPing()] to verify end-to-end connectivity
// with the repo.  Servers may add their own tags.
RepoPing: Dict {

  // Repo display name
  dis: Str
}

// Summary of one lib version available in a repo as reported by
// [repoVersions()], [repoFetch()], and [repoPublish()].
RepoLibVersion: Dict {

  // Dotted lib name
  lib: Str

  // Lib version
  version: Version

  // Publication maturity as claimed by the lib author
  maturity: LibMaturity

  // Availability lifecycle state of this version in the repo
  availability: RepoLibAvailability

  // Additional message associated with the availability state
  availabilityMsg: Str?

  // Summary documentation from the lib meta
  doc: Str?

  // Lib dependencies; omitted when not known such as in search results
  depends: List? <of:LibDepend>

  // Digest of the lib's xetolib zip file formatted as "sha256:"
  // followed by the base64uri encoding of the SHA-256 hash.  Clients
  // should verify fetched content against this digest when available.
  digest: Str?
}

// Availability lifecycle state of a lib version as reported by the
// repo.  This is mutable repo catalog state, not metadata of the lib
// artifact itself - a version may be yanked or deleted after
// publication without its zip ever changing.
RepoLibAvailability: Enum {
  available // Served normally
  yanked    // Withdrawn from new resolution; exact pins still resolve
  deleted   // Content deleted from storage; never served, version stays burned
}

// Search results as reported by [repoSearch()].  Results are the best
// matches in server-chosen relevance order, up to the applied limit.
RepoSearch: Dict {

  // Matching libs for this query
  libs: List <of:RepoLibSummary>

  // Present when additional matches exist beyond those returned; the
  // client should refine the query (or raise the limit) to see more
  more: Marker?

  // Total count of matching libs when the server chooses to compute
  // it.  Null means unreported, not zero; servers may omit or cap
  // this when counting is expensive.
  total: Int?
}

// Summary of one lib as reported by [repoSearch()].
RepoLibSummary: Dict {

  // Dotted lib name
  lib: Str

  // Newest served version
  latestVersion: Version

  // Maturity of the latestVersion as claimed by the lib author
  latestMaturity: LibMaturity

  // Publish timestamp of latestVersion or null if unknown
  latestPublished: DateTime?

  // Newest served version with stable maturity; null when the lib has
  // no stable release, such as one which has only ever shipped alphas
  latestStable: Version?

  // Present when this lib is deprecated: no further development is
  // expected and new adoption is discouraged.  The message provides
  // migration guidance; see the lib's page on the repo website for
  // full details.
  deprecated: Str?

  // Summary documentation from the lib meta
  doc: Str?
}

